Algoritmo Vectores
	
	Definir i, TAM Como Entero;
	Definir vnombre Como Caracter;
	TAM =100;
	Dimension vnombre[100];
	
	
	
	Para i=0 Hasta (TAM-1) Con Paso 1 Hacer
		Escribir "Dime el nombre " i " º para guardarlo";
		Leer vnombre[i];
	Fin Para
	
	Para i=0 Hasta (TAM-1) Con Paso 1 Hacer
		Escribir "El nombre guardado en " i " º posición es "  vnombre[i];
		Leer vnombre[i];
	Fin Para
	
	
	
FinAlgoritmo
